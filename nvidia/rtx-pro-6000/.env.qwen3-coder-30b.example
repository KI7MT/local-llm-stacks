# RTX PRO 6000 Blackwell, 96 GB: Qwen3-Coder-30B-A3B-Instruct at Q8. Copy to .env and edit.
#
# The lab's previous coding model. The fastest generation measured on this card, and it leaves
# more than half the card free (about 38 GiB at 131072 context), but it failed the coding task
# that gpt-oss-120b passed (docs/measured.md).
#   hf download unsloth/Qwen3-Coder-30B-A3B-Instruct-GGUF Qwen3-Coder-30B-A3B-Instruct-Q8_0.gguf --local-dir $MODEL_DIR
# (The lab's copy came from another upload of the same Q8_0 quantization, 32.5 GB.)
MODEL_DIR=/srv/models/qwen3-coder-30b-q8
MODEL_FILE=Qwen3-Coder-30B-A3B-Instruct-Q8_0.gguf

CTX=131072

BIND=127.0.0.1
PORT=8080

# Generate one: openssl rand -hex 32
LLAMA_API_KEY=

# Qwen's published sampling for Qwen3-Coder, set in the client: temperature 0.7, top_p 0.8,
# top_k 20, repetition penalty 1.05. Without them the model tends to loop in agent use.
