# RTX PRO 6000 Blackwell, 96 GB: gpt-oss-120b. Copy to .env and edit.
#
# The lab's current coding model: the fastest and most reliable of five candidates on the same
# task (docs/measured.md). About 67 GiB in use at the full 131072 context.
#
# The file is called F16 in unsloth's naming, but the experts are gpt-oss's native MXFP4.
#   hf download unsloth/gpt-oss-120b-GGUF --include "gpt-oss-120b-F16.gguf" --local-dir $MODEL_DIR
MODEL_DIR=/srv/models/gpt-oss-120b
MODEL_FILE=gpt-oss-120b-F16.gguf

# gpt-oss's own maximum.
CTX=131072

# 127.0.0.1 keeps it on this machine. See docs/security.md before changing it.
BIND=127.0.0.1
PORT=8080

# Generate one: openssl rand -hex 32
LLAMA_API_KEY=

# Sampling is set by the client, not here. OpenAI's recommendation for gpt-oss:
# temperature 1.0, top_p 1.0.
