# RTX 5090, 32 GB. Copy to .env and edit.
#
# NOT MEASURED YET. Same Blackwell architecture and the same Compose file as the 5080, which the
# lab did run; this file only sizes the model for twice the memory.
#
# Model: Qwen3-Coder-30B-A3B-Instruct, Q4_K_M (about 18.6 GB). A mixture-of-experts model with
# 3B active parameters, so it is fast for its size.
#   hf download unsloth/Qwen3-Coder-30B-A3B-Instruct-GGUF Qwen3-Coder-30B-A3B-Instruct-Q4_K_M.gguf --local-dir $MODEL_DIR
MODEL_DIR=/srv/models/qwen3-coder-30b
MODEL_FILE=Qwen3-Coder-30B-A3B-Instruct-Q4_K_M.gguf

# Room for the q8_0 KV cache beside about 18.6 GB of weights. Halve it on a CUDA out-of-memory
# error at load.
CTX=65536

BIND=127.0.0.1
PORT=8080

# Generate one: openssl rand -hex 32
LLAMA_API_KEY=
