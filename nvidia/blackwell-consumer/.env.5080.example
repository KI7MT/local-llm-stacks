# RTX 5080, 16 GB. Copy to .env and edit.
#
# Model: Qwen2.5-14B-Instruct, Q5_K_M, one 10.5 GB file. The lab ran exactly this on the 5080.
#   hf download bartowski/Qwen2.5-14B-Instruct-GGUF Qwen2.5-14B-Instruct-Q5_K_M.gguf --local-dir $MODEL_DIR
MODEL_DIR=/srv/models/qwen2.5-14b
MODEL_FILE=Qwen2.5-14B-Instruct-Q5_K_M.gguf

# 32768 leaves room beside 10.5 GB of weights with the q8_0 KV cache. If the server logs a CUDA
# out-of-memory error at load, halve it.
CTX=32768

# 127.0.0.1 keeps it on this machine. See docs/security.md before changing it.
BIND=127.0.0.1
PORT=8080

# Generate one: openssl rand -hex 32
LLAMA_API_KEY=
